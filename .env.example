# Chỉ dùng trên máy phát triển. Không commit .env hoặc .dev.vars.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
# Production cần giá trị ngẫu nhiên tối thiểu 32 ký tự; không gửi cho client.
SESSION_SECRET=
API_BASE_URL=http://127.0.0.1:8787
OFFLINE_AUTH_DAYS=7
# Chỉ cấu hình khi được phép triển khai cloud.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BACKUP_AGE_RECIPIENT=
R2_BACKUP_BUCKET=
