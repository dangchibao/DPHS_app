# Chỉ dùng trên máy phát triển. Không commit .env hoặc .dev.vars.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
# Production cần giá trị ngẫu nhiên tối thiểu 32 ký tự; không gửi cho client.
SESSION_SECRET=
API_BASE_URL=http://127.0.0.1:8787
OFFLINE_AUTH_DAYS=7
# Chỉ cấu hình khi được phép triển khai cloud.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BACKUP_BUCKET=
# Pipeline backup: GitHub mapping R2_BACKUP_BUCKET -> R2_BUCKET.
R2_BUCKET=
R2_ENDPOINT_URL=
R2_BACKUP_STORAGE_BUDGET_BYTES=8000000000
D1_DATABASE_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_GPG_PUBLIC_KEY=
BACKUP_GPG_FINGERPRINT=
# Analytics chỉ đọc, tùy chọn. Chưa đặt thì màn Usage ghi rõ chưa có số đo.
CF_ANALYTICS_TOKEN=
# Chỉ đổi ngân sách hiển thị sau khi chủ đổi gói; không tự mua/nâng gói.
CLOUD_BUDGET_JSON=

# Phục hồi chỉ vào D1 staging mới, không trùng D1_DATABASE_ID. Không tự deploy.
D1_RESTORE_TARGET_ID=
D1_RESTORE_API_TOKEN=
# Android: all four or none; keep keystore outside the repository.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
ANDROID_REQUIRE_RELEASE_SIGNING=
