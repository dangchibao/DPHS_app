{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ngoc-thanh-pos-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [{
    "binding": "DB", "database_name": "ngoc-thanh-pos",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {"ENVIRONMENT": "development", "ALLOWED_ORIGIN": "http://localhost:8080"}
}
