{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Copy to wrangler.production.local.jsonc, replace placeholders, review before deploying.
  "name": "ngoc-thanh-pos-production-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "replace-with-approved-database",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "assets": {
    "directory": "../app/build/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health", "/auth/*", "/devices/*", "/directory", "/management",
      "/staff", "/staff/*", "/sync/*", "/payroll/*", "/reports/*", "/web/*",
      "/media/*", "/usage", "/audit/*"
    ]
  },
  // Add IMAGES and/or AUDIT_ARCHIVES R2 bindings only after private bucket/budget review.
  // Never add secrets to this file. Use wrangler secret put with the chosen config.
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGIN": "https://replace-with-approved-origin.workers.dev"
  }
}
